# Doctor text output for expired claims must not expose claim IDs.

np-init DRTXT
np-seed task 'Expired for text doctor' doctor-redact TASK

# Claim with a 1ms duration so the claim expires immediately.
exec np claim $TASK --author doctor-redact --duration 1ms --json
np-capture CLAIM claim_id

# Doctor text output must not contain the claim ID.
exec np admin doctor
! stdout $CLAIM@R

-- CLAUDE.md --
Use np to manage issues. Run `np agent prime` for setup.
