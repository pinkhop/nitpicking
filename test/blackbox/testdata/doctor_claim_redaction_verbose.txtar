# Doctor verbose JSON output for expired claims must not expose claim IDs.

np-init DRVRB
np-seed task 'Expired for verbose doctor' doctor-redact TASK

# Claim with a 1ms duration so the claim expires immediately.
exec np claim $TASK --author doctor-redact --duration 1ms --json
np-capture CLAIM claim_id

# Verbose doctor output must not contain the claim ID.
exec np admin doctor --verbose --json
! stdout $CLAIM@R
! stdout '"claim_id"'

-- CLAUDE.md --
Use np to manage issues. Run `np agent prime` for setup.
