# Verify that attempting to use an expired claim ID for a mutation is rejected.
# An expired claim provides no authority — the holder must re-claim the issue.

np-init STLR
np-seed task 'Will expire' agent-alpha TASK

# Agent A claims with a very short duration so the claim expires immediately.
exec np claim $TASK --author agent-alpha --duration 1ms --json
np-capture CLAIM_A claim_id

# Agent A attempts to update using the now-expired claim — must fail.
stdin update.json
! exec np json update --claim $CLAIM_A
stderr 'claim is expired'

-- update.json --
{"title": "Should not apply"}
